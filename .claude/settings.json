{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Edit",
      "Bash(npm run storybook)",
      "Bash(npm run build)",
      "Bash(npm run build-storybook)",
      "Bash(npm run apps:help)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm publish*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ]
  }
}
